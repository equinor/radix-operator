{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch-Webhook",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/webhook/main.go",
			"env": {
				"RADIXCONFIG_WEBHOOK_LOGLEVEL": "info",
				"RADIXCONFIG_WEBHOOK_LOGPRETTYPRINT": "true",
				"RADIXCONFIG_WEBHOOK_CERTSDIR": "${workspaceFolder}/local/certs"
			}
		},
		{
			"name": "Launch-build-deploy-pipeline",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/pipeline-runner/main.go",
			"env": {
				"KUBERNETES_SERVICE_PORT": "443",
				// "CONFIG_OVERRIDE_FILENAME": "${workspaceFolder}/pipelineconfig.override.yaml"
			},
			"args": [
				"--app-name=oauth-demo",
				"--git-ref=main",
				"--commit-id=02a0a6b06973d34bf7dd0e2dc6bfb5d59b1d99c0",
				"--job-name=radix-pipeline-20231113133209-w",
				"--image-tag=abcdl",
				"--pipeline-type=build-deploy",
				"--debug=true",
				"--push-image=true",
				"--radix-config-file-name=radixconfig.yaml",
				"--github-workspace=/workspace",
				"--config-map-name=radix-common-config",
				"--config-map-namespace=default"
			]
		},
		{
			"name": "Launch-promote-pipeline",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/pipeline-runner/main.go",
			"env": {
				"KUBERNETES_SERVICE_PORT": "443",
				// "CONFIG_OVERRIDE_FILENAME": "${workspaceFolder}/pipelineconfig.override.yaml"
			},
			"args": [
				"--app-name=oauth-demo",
				"--image-tag=abcdef",
				"--job-name=radix-pipeline-20231121120818-sb2xq",
				"--pipeline-type=promote",
				"--promote-from-environment=dev",
				"--to-environment=prod",
				"--promote-deployment-name=dev-hyxzv-j9pg34k2",
				"--radix-config-file-name=radixconfig.yaml",
				"--debug=true",
				"--github-workspace=/workspace",
				"--config-map-name=radix-common-config",
				"--config-map-namespace=default"
			]
		},
		{
			"name": "Launch-deploy-pipeline",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/pipeline-runner/main.go",
			"env": {
				"KUBERNETES_SERVICE_PORT": "443",
				// "CONFIG_OVERRIDE_FILENAME": "${workspaceFolder}/pipelineconfig.override.yaml"
			},
			"args": [
				"--app-name=radix-job-demo",
				"--job-name=radix-pipeline-20231030091802-mfzoz",
				"--pipeline-type=deploy",
				"--to-environment=prod",
				"--debug=true",
				"--radix-config-file-name=radixconfig.yaml",
				"--github-workspace=/workspace",
				"--config-map-name=radix-common-config",
				"--config-map-namespace=default"
			]
		},
		{
			"name": "Launch-applyconfig-pipeline",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/pipeline-runner/main.go",
			"env": {
				"KUBERNETES_SERVICE_PORT": "443",
				// "CONFIG_OVERRIDE_FILENAME": "${workspaceFolder}/pipelineconfig.override.yaml"
			},
			"args": [
				"--app-name=oauth-demo",
				"--job-name=radix-pipeline-20231030091802-mfzoz",
				"--pipeline-type=apply-config",
				"--debug=true",
				"--radix-config-file-name=radixconfig.yaml",
				"--apply-config-deploy-external-dns=true",
				"--github-workspace=/workspace",
				"--config-map-name=radix-common-config",
				"--config-map-namespace=default"
			]
		},
		{
			"name": "Launch-operator",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/operator/main.go",
			"env": {
				"USE_PROFILER": "true",
				"KUBERNETES_SERVICE_PORT": "443",
				"RADIXCONFIG_OPERATOR_LOGLEVEL": "info",
				"RADIXCONFIG_OPERATOR_LOGPRETTYPRINT": "true",
				// "RADIXCONFIG_OPERATOR_PIPELINEIMAGE_REPOSITORY": "radixdev.azurecr.io/radix-pipeline",
				// "RADIXCONFIG_OPERATOR_PIPELINEIMAGE_TAG": "dev"
			},
			"args": ["--useOutClusterClient=false"]
		},
		{
			"name": "Launch-job-scheduler",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/job-scheduler/main.go",
			"env": {
				"USE_SWAGGER": "true",
				"USE_PROFILER": "false",
				"RADIX_APP": "jacob-dev",
				"RADIX_ENVIRONMENT": "dev",
				"RADIX_COMPONENT": "cron-job",
				"RADIX_DEPLOYMENT": "dev-kxyz6-ntszobl6",
				"RADIX_PORTS": "3000"
			}
		},
		{
			"name": "Test RadixEnvironment",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${workspaceFolder}/pkg/apis/environment",
			"env": {},
			"args": ["environment_test.go"]
		},
		{
			"name": "Test RadixApplication",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${workspaceFolder}/pkg/apis/applicationconfig",
			"env": {},
			"args": ["applicationconfig_test.go"]
		},
		{
			"name": "Launch e2e tests",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${workspaceFolder}/e2e",
			"args": ["-test.v", "-test.timeout", "30m"]
		},
		{
			"name": "Launch API Server",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/api-server/main.go",
			"env": {
				"POD_NAMESPACE": "default",
				"KUBERNETES_SERVICE_PORT": "443",
				"RADIXCONFIG_APISERVER_LOGLEVEL": "debug",
				"RADIXCONFIG_APISERVER_LOGPRETTYPRINT": "true",
				"RADIXCONFIG_APISERVER_PROMETHEUSURL": "http://localhost:9091"
			}
		}
	]
}
