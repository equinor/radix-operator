{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch-Webhook",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/webhook/main.go",
			"env": {
				"RADIXCONFIG_WEBHOOK_LOGLEVEL": "info",
				"RADIXCONFIG_WEBHOOK_LOGPRETTYPRINT": "true",
				"RADIXCONFIG_WEBHOOK_CERTSDIR": "${workspaceFolder}/local/certs"
			}
		},
		{
			"name": "Launch-build-deploy-pipeline",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/pipeline-runner/main.go",
			"env": {},
			"args": [
				"--RADIX_APP=oauth-demo",
				"--BRANCH=main",
				"--COMMIT_ID=02a0a6b06973d34bf7dd0e2dc6bfb5d59b1d99c0",
				"--JOB_NAME=radix-pipeline-20231113133209-w",
				"--IMAGE_TAG=abcdl",
				"--PIPELINE_TYPE=build-deploy",
				"--DEBUG=true",
				"--builder-image=ghcr.io/equinor/radix/buildkit-builder:latest",
				"--builder-seccomp-profile-localhost-profile=allow-buildah.json",
				"--RADIX_CLUSTER_TYPE=development",
				"--cluster-name=weekly-28",
				"--container-registry=radixdev.azurecr.io",
				"--cache-container-registry=radixdevapp.azurecr.io",
				"--PUSH_IMAGE=true",
				"--RADIX_FILE_NAME=radixconfig.yaml",
				// "--TO_ENVIRONMENT=dev",
				// "--IMAGE_TAG_NAME=server=1.23-alpine-slim",
				// "--IMAGE_TAG_NAME=server2=1.22.1-alpine-perl",
				"--external-registry-auth-secret=radix-external-registry-default-auth",
				"--RADIX_GITHUB_WORKSPACE=/workspace"
			]
		},
		{
			"name": "Launch-promote-pipeline",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/pipeline-runner/main.go",
			"env": {},
			"args": [
				"--RADIX_APP=oauth-demo",
				"--IMAGE_TAG=abcdef",
				"--JOB_NAME=radix-pipeline-20231121120818-sb2xq",
				"--PIPELINE_TYPE=promote",
				"--FROM_ENVIRONMENT=dev",
				"--TO_ENVIRONMENT=prod",
				"--DEPLOYMENT_NAME=dev-hyxzv-j9pg34k2",
				"--RADIX_FILE_NAME=radixconfig.yaml",
				"--DEBUG=true",
				"--container-registry=radixdev.azurecr.io",
				"--RADIX_GITHUB_WORKSPACE=/workspace"
			]
		},
		{
			"name": "Launch-deploy-pipeline",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/pipeline-runner/main.go",
			"env": {},
			"args": [
				"--RADIX_APP=radix-job-demo",
				"--JOB_NAME=radix-pipeline-20231030091802-mfzoz",
				"--PIPELINE_TYPE=deploy",
				"--TO_ENVIRONMENT=prod",
				"--DEBUG=true",
				"--RADIX_FILE_NAME=radixconfig.yaml",
				"--RADIX_CLUSTER_TYPE=development",
				"--cluster-name=weekly-28",
				"--container-registry=radixdev.azurecr.io",
				"--RADIX_GITHUB_WORKSPACE=/workspace"
			]
		},
		{
			"name": "Launch-applyconfig-pipeline",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/pipeline-runner/main.go",
			"env": {},
			"args": [
				"--RADIX_APP=oauth-demo",
				"--JOB_NAME=radix-pipeline-20231030091802-mfzoz",
				"--PIPELINE_TYPE=apply-config",
				"--DEBUG=true",
				"--RADIX_FILE_NAME=radixconfig.yaml",
				"--RADIX_CLUSTER_TYPE=development",
				"--cluster-name=weekly-28",
				"--container-registry=radixdev.azurecr.io",
				"--APPLY_CONFIG_DEPLOY_EXTERNALDNS=true",
				"--RADIX_GITHUB_WORKSPACE=/workspace"
			]
		},
		{
			"name": "Launch-operator",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/operator/main.go",
			"env": {
				"USE_PROFILER": "true",
				"KUBERNETES_SERVICE_PORT": "443",
				"RADIXCONFIG_OPERATOR_LOGLEVEL": "info",
				"RADIXCONFIG_OPERATOR_LOGPRETTYPRINT": "true"
			},
			"args": ["--useOutClusterClient=false"]
		},
		{
			"name": "Launch-job-scheduler",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/job-scheduler/main.go",
			"env": {
				"USE_SWAGGER": "true",
				"USE_PROFILER": "false",
				"RADIX_APP": "jacob-dev",
				"RADIX_ENVIRONMENT": "dev",
				"RADIX_COMPONENT": "cron-job",
				"RADIX_DEPLOYMENT": "dev-kxyz6-ntszobl6",
				"RADIX_PORTS": "3000"
			}
		},
		{
			"name": "Test RadixEnvironment",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${workspaceFolder}/pkg/apis/environment",
			"env": {},
			"args": ["environment_test.go"]
		},
		{
			"name": "Test RadixApplication",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${workspaceFolder}/pkg/apis/applicationconfig",
			"env": {},
			"args": ["applicationconfig_test.go"]
		},
		{
			"name": "Launch e2e tests",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${workspaceFolder}/e2e",
			"args": ["-test.v", "-test.timeout", "30m"]
		},
		{
			"name": "Launch API Server",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/api-server/main.go",
			"env": {
				"POD_NAMESPACE": "default",
				"KUBERNETES_SERVICE_PORT": "443",
				"RADIXCONFIG_APISERVER_LOGLEVEL": "debug",
				"RADIXCONFIG_APISERVER_LOGPRETTYPRINT": "true",
				"RADIXCONFIG_APISERVER_PROMETHEUSURL": "http://localhost:9091"
			}
		}
	]
}
